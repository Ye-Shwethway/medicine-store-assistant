# Copy to a protected runtime-only .env outside the public repository workflow.
# Never commit real credentials.

MSA_ENVIRONMENT=development
MSA_SERVICE_VERSION=0.1.0-dev
MSA_BUILD_SHA=unknown
MSA_API_HOST_PORT=8088

POSTGRES_DB=msa
POSTGRES_USER=msa
POSTGRES_PASSWORD=replace-with-runtime-secret

# F7.2A canonical Owner bootstrap. The existing password hash is migrated into
# the canonical users table without exposing plaintext. Username defaults to owner.
MSA_DASHBOARD_OWNER_USERNAME=owner
MSA_DASHBOARD_OWNER_PASSWORD_HASH=
MSA_DASHBOARD_SESSION_SECRET=
MSA_DASHBOARD_SESSION_TTL_SECONDS=28800
